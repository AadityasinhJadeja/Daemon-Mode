{
  "manifest_version": 3,
  "key": "",
  "name": "Daemon Mode",
  "description": "Save allowed web pages locally so your AI agents can recall them later with evidence and citations.",
  "version": "0.5.10",
  "incognito": "not_allowed",
  "icons": {
    "16": "assets/icons/dmn-icon-16.png",
    "32": "assets/icons/dmn-icon-32.png",
    "48": "assets/icons/dmn-icon-48.png",
    "128": "assets/icons/dmn-icon-128.png"
  },
  "permissions": ["scripting", "storage", "webNavigation"],
  "host_permissions": ["http://127.0.0.1:4317/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Daemon Mode",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/dmn-icon-16.png",
      "32": "assets/icons/dmn-icon-32.png",
      "48": "assets/icons/dmn-icon-48.png",
      "128": "assets/icons/dmn-icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  }
}
